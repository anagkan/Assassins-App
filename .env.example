# Public domain pointing at this server (Caddy gets an HTTPS certificate for it automatically).
# Use "localhost" to try it out on your own machine.
DOMAIN=assassins.example.com

# Timezone used to display times and interpret times typed into forms.
TZ=America/New_York

# First admin account. Only used when the database has no admin yet; after you've
# logged in and changed the password you can delete these two lines.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
